{
  "manifest_version": 3,
  "name": "Trailer Catcher",
  "version": "1.0.0",
  "description": "Send the current YouTube video's media URLs to the local Trailer Catcher. Self-built; never installed from a store.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "*://*.googlevideo.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1:5961/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Catch this trailer",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
